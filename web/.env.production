# 生产环境（pnpm build）
#
# 约定：
#   VITE_*  会注入前端代码（公开变量，禁止放密钥）
#   BUILD_* 只被 vite.config.ts 读取，不会进入产物

# 应用基础路径（GitHub Pages 等子目录部署由 CI 用 VITE_BASE 覆盖）
VITE_BASE=/

# API 地址：生产由同域反向代理转发到后端
VITE_API_URL=/api/v1

VITE_DOC_URL=https://docs.canvas.best

# 官方插件注册表（显式写死，避免依赖代码默认值）
VITE_PLUGIN_REGISTRY_URL=https://cdn.jsdelivr.net/gh/basketikun/infinite-canvas@plugins-dist/official-plugins.json

# 统计：容器部署时通过 config.js 的 window.__RUNTIME_CONFIG__ 注入，优先级高于构建期值
# VITE_ANALYTICS_GA4_ID=
# VITE_ANALYTICS_BAIDU_ID=

# ── 构建开关（pnpm build）─────────────────────────────────────
# 生成 .br/.gz 预压缩产物、不保留 sourcemap、esbuild 压缩
BUILD_COMPRESSION=true
BUILD_SOURCEMAP=false
BUILD_MINIFY=true
