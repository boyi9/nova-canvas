# 开发环境（pnpm dev / pnpm dev:mock / pnpm build:dev）
#
# 约定：
#   VITE_*  会注入前端代码（公开变量，禁止放密钥）
#   BUILD_* 只被 vite.config.ts 读取，不会进入产物

# 应用基础路径（子目录部署时改成 /sub/）
VITE_BASE=/

# API 地址：开发期统一走 Vite proxy（见 vite.config.ts）
VITE_API_URL=/api/v1

# 在线文档 / 插件注册表（留空则使用 src/constant/env.ts 中的默认值）
VITE_DOC_URL=https://docs.canvas.best
# VITE_PLUGIN_REGISTRY_URL=

# 本地插件热更新（逗号分隔，每次启动刷新）
# VITE_DEV_PLUGINS=http://localhost:3001/plugin.js

# ── 本地 HTTPS（可选）────────────────────────────────────────
# 1) pnpm cert                 生成 web/certs/ 自签名证书（默认含 localhost / 局域网 IP）
# 2) 在 .env.local 写 HTTPS=1  （个人开关放 .env.local，不要改本文件）
# HTTPS=1
# HTTPS_CERT=certs/dev-cert.pem
# HTTPS_KEY=certs/dev-key.pem

# 统计：开发环境默认关闭
# VITE_ANALYTICS_GA4_ID=
# VITE_ANALYTICS_BAIDU_ID=

# ── 构建开关（仅 pnpm build:dev 生效）──────────────────────────
# 关闭预压缩、保留 sourcemap、关闭混淆，便于定位线上问题
BUILD_COMPRESSION=false
BUILD_SOURCEMAP=true
BUILD_MINIFY=false
