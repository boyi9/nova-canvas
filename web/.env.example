# Nova启画 环境变量配置模板
#
# 环境文件加载顺序（Vite 规则，后者覆盖前者）：
#   .env  <  .env.[mode]  <  .env.local  <  .env.[mode].local
#   process.env（CI / 命令行）优先级最高，可直接覆盖任意键
#
# 已提交、可直接使用的环境文件：
#   .env.development   pnpm dev / pnpm dev:mock / pnpm build:dev
#   .env.production    pnpm build
# 个人覆盖请用 .env.local / .env.[mode].local（已被 .gitignore 忽略）。
#
# 变量前缀约定：
#   VITE_*  会注入前端代码，属于公开变量，禁止放密钥
#   BUILD_* 只被 vite.config.ts 读取，不会进入产物

# ── 基础配置 ──────────────────────────────────────────────
# 应用基础路径（默认 "/"，子目录部署时修改）
VITE_BASE=/

# 后端 API 地址（默认走 Vite proxy "/api/v1"）
# VITE_API_URL=/api/v1

# 产物目录（相对 web/，默认 dist）
# BUILD_OUT_DIR=dist

# ── 文档 & 插件 ──────────────────────────────────────────
# 在线文档地址
VITE_DOC_URL=https://docs.canvas.best

# 插件注册表 CDN 地址
# VITE_PLUGIN_REGISTRY_URL=https://cdn.jsdelivr.net/gh/basketikun/infinite-canvas@plugins-dist/official-plugins.json

# ── 开发调试 ─────────────────────────────────────────────
# 本地开发插件 URL（逗号分隔，每次启动刷新，不缓存）
# VITE_DEV_PLUGINS=http://localhost:3001/plugin.js,http://localhost:3002/plugin.js

# ── 本地 HTTPS（可选）────────────────────────────────────
# 1) pnpm cert                 生成 web/certs/ 自签名证书
# 2) 在 .env.local 写 HTTPS=1   （个人开关不要写进已提交的 env 文件）
# 3) 信任证书（浏览器不再告警）：
#      Windows: certutil -user -addstore Root web\certs\dev-cert.pem
#      macOS:   sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain web/certs/dev-cert.pem
#      Linux:   sudo cp web/certs/dev-cert.pem /usr/local/share/ca-certificates/nova-dev.crt && sudo update-ca-certificates
# HTTPS=1
# HTTPS_CERT=certs/dev-cert.pem
# HTTPS_KEY=certs/dev-key.pem

# ── 数据统计 ─────────────────────────────────────────────
# 容器部署时优先读取 config.js 注入的 window.__RUNTIME_CONFIG__
# Google Analytics 4 measurement ID (G-XXXX)
# VITE_ANALYTICS_GA4_ID=G-XXXXXXXXXX

# 百度统计 site ID
# VITE_ANALYTICS_BAIDU_ID=xxxxxxxxxx

# ── 构建开关 ─────────────────────────────────────────────
# 生产默认：压缩 + 无 sourcemap + 混淆；开发构建默认相反
# BUILD_COMPRESSION=true     生成 .gz / .br 预压缩产物
# BUILD_SOURCEMAP=false      是否输出 .map
# BUILD_MINIFY=true          是否用 esbuild 压缩混淆
