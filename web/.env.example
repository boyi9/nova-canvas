# Nova启画 环境变量配置
# 复制此文件为 .env 并填入实际值

# ── 基础配置 ──────────────────────────────────────────────
# 应用基础路径（默认 "/"，子目录部署时修改）
VITE_BASE=/

# 后端 API 地址（默认走 Vite proxy "/api/v1"）
# VITE_API_URL=/api/v1

# ── 文档 & 插件 ──────────────────────────────────────────
# 在线文档地址
VITE_DOC_URL=https://docs.canvas.best

# 插件注册表 CDN 地址
# VITE_PLUGIN_REGISTRY_URL=https://cdn.jsdelivr.net/gh/basketikun/infinite-canvas@plugins-dist/official-plugins.json

# ── 开发调试 ─────────────────────────────────────────────
# 本地开发插件 URL（逗号分隔，每次启动刷新，不缓存）
# VITE_DEV_PLUGINS=http://localhost:3001/plugin.js,http://localhost:3002/plugin.js

# ── 数据统计 ─────────────────────────────────────────────
# Google Analytics 4 measurement ID (G-XXXX)
# VITE_ANALYTICS_GA4_ID=G-XXXXXXXXXX

# 百度统计 site ID
# VITE_ANALYTICS_BAIDU_ID=xxxxxxxxxx
