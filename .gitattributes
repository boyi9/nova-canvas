# 跨平台换行符约定（Windows 检出时必须让容器脚本保持 LF）
#
# 背景：nginx 官方镜像的 /docker-entrypoint.d/*.sh 由 /bin/sh 直接执行，
# 若带 CRLF 会报 "not found" 并导致容器启动失败。

*.sh          text eol=lf
*.conf        text eol=lf
*.inc         text eol=lf
Dockerfile    text eol=lf
# git hook 文件无扩展名，按目录匹配强制 LF（由 /bin/sh 直接执行，CRLF 会直接报错）
**/.husky/**  text eol=lf
*.ps1         text eol=crlf
