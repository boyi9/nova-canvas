# Nova Canvas Backend Configuration

# Server
PORT=8080
GIN_MODE=debug

# CORS (comma-separated origins; 必须带协议，禁止 "*"——因为允许携带 Cookie 凭据)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT (REQUIRED - generate with: openssl rand -hex 32, min 32 bytes)
# - 启动时会校验强度：缺失或过短直接退出（fail fast）
# - 轮换密钥会让所有已签发令牌立即失效（重新登录即可）
JWT_SECRET=
JWT_ISSUER=nova-canvas
# 访问令牌有效期（默认 15m，上限 24h）；刷新令牌默认 30d
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# 刷新令牌 Cookie：生产（HTTPS）必须设 true；本地 HTTP 调试可 false
AUTH_COOKIE_SECURE=false
# 可选的 Cookie 作用域（前后端不同子域时填写，例如 .example.com）
AUTH_COOKIE_DOMAIN=

# 敏感配置加密（可选）：给环境变量里的密钥再加一层 AES-256-GCM
#   1) go run ./cmd/secretctl genkey            生成 NOVA_SECRET_KEY
#   2) go run ./cmd/secretctl seal --value '<AI_PROVIDERS 的 JSON>'
#   3) 把密文填入 AI_PROVIDERS_ENC（此时不要再设置 AI_PROVIDERS 明文）
NOVA_SECRET_KEY=
AI_PROVIDERS_ENC=

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=nova
DB_PASSWORD=your_password
DB_NAME=nova_canvas
DB_SSLMODE=disable
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100

# Redis (for async task queue)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# AI API Keys
DEEPSEEK_API_KEY=
SEEDREAM_API_KEY=
SEEDREAM_API_SECRET=
SEEDANCE_API_KEY=
FLUX_API_KEY=

# Object Storage (S3-compatible)
S3_BUCKET=nova-canvas-assets
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Rate Limiting
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
# 反向代理信任列表（逗号分隔 IP/CIDR）。留空 = 不信任任何 X-Forwarded-For，
# 防止伪造请求头绕过按 IP 限流；本机 nginx 反代时填 127.0.0.1。
TRUSTED_PROXIES=
