# Nova Canvas Backend Configuration

# Server
PORT=8080
GIN_MODE=debug

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT (REQUIRED - generate with: openssl rand -hex 32)
JWT_SECRET=

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=nova
DB_PASSWORD=your_password
DB_NAME=nova_canvas
DB_SSLMODE=disable
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100

# Redis (for async task queue)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# AI API Keys
DEEPSEEK_API_KEY=
SEEDREAM_API_KEY=
SEEDREAM_API_SECRET=
SEEDANCE_API_KEY=
FLUX_API_KEY=

# Object Storage (S3-compatible)
S3_BUCKET=nova-canvas-assets
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Rate Limiting
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
